#!/usr/bin/env bash
# Build the site from Backtrack's newest release and publish it to
# backtrack.tools: the guides, the install page and the changelog fetched at
# that release's tag, the site built and checked, the bucket made to match
# public/, then CloudFront told to forget what it holds, so the change shows
# at once. Pages are cached for five minutes at most. A fetch, build or check
# that fails stops here, before anything is uploaded.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=/dev/null
. infra/resources.env
scripts/fetch-docs
zola build
scripts/check-site
scripts/check-contrast > /dev/null || scripts/check-contrast
aws s3 sync public/ "s3://$BUCKET/" --delete --cache-control "max-age=300"
aws cloudfront create-invalidation --distribution-id "$DISTRIBUTION" --paths '/*' \
    --query 'Invalidation.[Id,Status]' --output text
