#!/usr/bin/env bash
# Build the site and publish it to backtrack.tools: the bucket made to match
# public/, then CloudFront told to forget what it holds, so the change shows at
# once. Pages are cached for five minutes at most. A build that fails stops
# here, before anything is uploaded.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=/dev/null
. infra/resources.env
zola build
aws s3 sync public/ "s3://$BUCKET/" --delete --cache-control "max-age=300"
aws cloudfront create-invalidation --distribution-id "$DISTRIBUTION" --paths '/*' \
    --query 'Invalidation.[Id,Status]' --output text
